# Application
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
DEBUG=true

# PostgreSQL
DATABASE_URL=postgresql+asyncpg://wallet_user:wallet_pass@postgres:5432/wallet_db

# Kafka
KAFKA_BOOTSTRAP_SERVERS=kafka:9092
KAFKA_TRANSFER_TOPIC=transfers
KAFKA_DLQ_TOPIC=transfers.dlq
KAFKA_CONSUMER_GROUP=transfer-consumer-group

# Redis
REDIS_URL=redis://redis:6379/0

# Worker settings
OUTBOX_POLL_INTERVAL_SECONDS=2
RECOVERY_JOB_INTERVAL_SECONDS=60
RECONCILIATION_JOB_INTERVAL_SECONDS=300
STUCK_TRANSFER_THRESHOLD_MINUTES=10
MAX_TRANSFER_RETRY_COUNT=3
